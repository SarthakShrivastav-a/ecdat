              "name": "AES (algorithm)",
              "shortDescription": {
                "text": "AES: weakened"
              },
              "fullDescription": {
                "text": "Grover's algorithm halves the effective key length; key size not yet known"
              },
              "helpUri": "https://cyclonedx.org/capabilities/cbom/",
              "properties": {
                "quantum_class": "weakened",
                "primitive": "block-cipher"
              }
