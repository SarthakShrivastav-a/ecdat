          "rules": [
            {
              "id": "ecdat/algorithm/RSA",
              "name": "RSA (algorithm)",
              "shortDescription": {
                "text": "RSA: broken"
              },
              "fullDescription": {
                "text": "Integer factorisation is broken by Shor's algorithm"
              },
              "helpUri": "https://cyclonedx.org/capabilities/cbom/",
              "properties": {
                "quantum_class": "broken",
                "primitive": "pke"
              }
            },
            {
              "id": "ecdat/algorithm/SHA-256",
              "name": "SHA-256 (algorithm)",
              "shortDescription": {
                "text": "SHA-256: safe"
              },
              "fullDescription": {
                "text": "128-bit collision resistance holds; Grover pre-image gain is impractical"
              },
              "helpUri": "https://cyclonedx.org/capabilities/cbom/",
              "properties": {
                "quantum_class": "safe",
                "primitive": "hash"
              }
            },
